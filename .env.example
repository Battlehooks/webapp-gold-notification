# Used by docker-compose to fill in each service's environment.
# Copy to .env in this directory and fill in real values -- same
# credentials as the root project's own .env.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=gpt-4o-mini
SUMOPOD_CHAT_MODEL=gpt-4o-mini

GNEWS_API_KEY=
TAVILY_API_KEY=

# Shared secret the frontend admin panel must send to the Notification
# Service's /admin routes.
ADMIN_TOKEN=change-me
