# The one secrets file for every service, standalone or docker-compose.
# Copy to services/.env and fill in; never commit it. Every other setting has
# a working default in each service's config. A services/<name>/.env, if
# present, overrides values here for that one service.

# LLM API key (ai.sumopod.com)
SUMOPOD_API_KEY=

# Optional news context -- blank skips it
GNEWS_API_KEY=
TAVILY_API_KEY=

# Postgres connection string from Sumobase's "Direct Connection" tab.
# Blank = every service keeps its own SQLite file.
DATABASE_URL=

# Web push alerts (desktop/browser notifications). Generate the pair once:
#   cd services/notification && npx web-push generate-vapid-keys
# Blank = alerts off (everything else still works). Changing the pair later
# means every browser has to turn alerts on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Ops agent's /chat token (only if you use the Agent page) -- whoever has it
# gets shell access to the machine the agent runs on.
AGENT_TOKEN=
