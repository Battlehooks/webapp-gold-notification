NOTIFICATION_DB_PATH=./notification.db
PORT=3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# In docker-compose these are service names (http://market-data:8001,
# http://insight:8002); locally they're localhost.
MARKET_DATA_URL=http://localhost:8001
INSIGHT_URL=http://localhost:8002

# Agent Service -- owner-only ops agent with real shell access, runs
# bare-metal (not in docker-compose). In the full compose stack this must be
# http://host.docker.internal:8003, not a compose service name (there isn't
# one) and not localhost (this container's localhost isn't the VPS host's).
AGENT_URL=http://localhost:8003
AGENT_TOKEN=

# Shared secret the frontend admin panel sends as the x-admin-token header
ADMIN_TOKEN=change-me

SUDDEN_MOVE_COOLDOWN_MIN=60
