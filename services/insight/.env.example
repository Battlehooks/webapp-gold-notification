INSIGHT_DB_PATH=./insight.db
PORT=8002

# Where the Market Data Service is reachable -- in docker-compose this is
# the service name (http://market-data:8001); locally it's localhost.
MARKET_DATA_URL=http://localhost:8001

SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=gpt-4o-mini
SUMOPOD_CHAT_MODEL=gpt-4o-mini

RESPONDER_MAX_TOOL_ROUNDS=3
RESPONDER_CHAT_HISTORY_TURNS=8
ANALYSIS_RUNS_KEEP_PER_GROUP=20

# Optional -- blank means no news context / no sudden-move "why"
GNEWS_API_KEY=
TAVILY_API_KEY=
