AGENT_DB_PATH=./agent.db
PORT=8003

# The single most dangerous secret in this repo -- required as the
# x-agent-token header on every /chat call. Whoever holds this token has
# full, unsandboxed shell access to wherever this process runs. Never log
# it, never commit a real value, never reuse it as any other service's
# secret, and rotate it immediately if it ever leaks.
AGENT_TOKEN=

# Notification Service's admin API, for the subscriber-management tools --
# never touches notification.db directly, only its existing HTTP routes.
NOTIFICATION_URL=http://localhost:3000
ADMIN_TOKEN=change-me

SUMOPOD_API_KEY=
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_CHAT_MODEL=gpt-4o-mini

AGENT_MAX_TOOL_ROUNDS=6
AGENT_CHAT_HISTORY_TURNS=12

# Directory containing docker-compose.yml, so the docker_ops tools run
# `docker compose ...` against the right project. Defaults to this repo's
# root when running standalone from services/agent/.
COMPOSE_PROJECT_DIR=../..

# Hard server-side cap on run_shell's timeout_seconds, regardless of what
# the model requests.
MAX_SHELL_TIMEOUT_SECONDS=120

# Comma-separated allowed browser origins. Deliberately narrow, unlike
# Insight's wide-open CORS -- this service can run shell commands.
CORS_ALLOW_ORIGINS=http://localhost:5173
